<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <LangVersion>12.0</LangVersion>
        <Nullable>enable</Nullable>
        <Version>0.328.0.1</Version>
        <ImplicitUsings>enable</ImplicitUsings>
        <Configurations>Debug;Release;NoRewards;Trace</Configurations>
        <PackageId>GuildWars2EliteInsights.GW2EIParserCommons</PackageId>
        <Company>GW2 Elite Insights</Company>
        <Product>GW2 Elite Insights</Product>
        <Authors>EliphasNUIT</Authors>
        <RepositoryUrl>https://github.com/baaron4/GW2-Elite-Insights-Parser</RepositoryUrl>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
        <DefineConstants>DEBUG</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Trace|AnyCPU'">
        <DefineConstants>TRACING</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='NoRewards|AnyCPU'">
        <DefineConstants>DEBUG</DefineConstants>
    </PropertyGroup>
    <PropertyGroup>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    <PropertyGroup>
        <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    </PropertyGroup>

    <PropertyGroup>
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="Content\SkillList.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="Content\SpecList.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="Content\MapList.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.1" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\GW2EI.Repositories\GW2EIGW2API\GW2EIGW2API.csproj" />
        <ProjectReference Include="..\..\GW2EI.Repositories\GW2EIDiscord\GW2EIDiscord.csproj" />
        <ProjectReference Include="..\..\GW2EI.Repositories\GW2EIDPSReport\GW2EIDPSReport.csproj" />
        <ProjectReference Include="..\..\GW2EI.Repositories\GW2EIUpdater\GW2EIUpdater.csproj">
			<Private>false</Private>
			<ExcludeAssets>runtime</ExcludeAssets>
		</ProjectReference>
        <ProjectReference Include="..\..\GW2EI.Repositories\GW2EIWingman\GW2EIWingman.csproj" />
        <ProjectReference Include="..\GW2EIBuilders\GW2EIBuilders.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="Settings\sample.conf">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>
