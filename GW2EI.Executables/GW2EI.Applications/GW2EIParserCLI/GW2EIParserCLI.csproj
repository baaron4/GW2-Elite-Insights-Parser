<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>disable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>GW2EIParser</RootNamespace>

        <Deterministic>false</Deterministic>

        <AssemblyTitle>EliteInsights-CLI</AssemblyTitle>
        <Product>EliteInsights-CLI</Product>
        <Copyright>Copyright ©  2024</Copyright>
        <Configurations>Debug;Release;NoRewards;Trace</Configurations>
        
        <Company>GW2 Elite Insights</Company>
        <Product>GW2 Elite Insights</Product>
        <Authors>Rennorb</Authors>
        <PackageId>GuildWars2EliteInsights.GW2EIParserCLI</PackageId>
        <RepositoryUrl>https://github.com/baaron4/GW2-Elite-Insights-Parser</RepositoryUrl>

        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>

        <ApplicationIcon>Content\ArenaNet\LI.ico</ApplicationIcon>
        <AssemblyName>GuildWars2EliteInsights-CLI</AssemblyName>
        <OutputPath>..\..\..\GW2EI.bin\$(Configuration)\CLI\</OutputPath>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    </PropertyGroup>
    <PropertyGroup>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
        <DefineConstants>DEBUG</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Trace|AnyCPU'">
        <DefineConstants>TRACING</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='NoRewards|AnyCPU'">
        <DefineConstants>DEBUG</DefineConstants>
    </PropertyGroup>
    <ItemGroup>
        <None Include="Content\ArenaNet\LI.ico" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\GW2EI.Library\GW2EI.Services\GW2EIParserCommons\GW2EIParserCommons.csproj" />
        <ProjectReference Include="..\..\..\GW2EI.Library\GW2EI.Repositories\GW2EIGW2API\GW2EIGW2API.csproj" />
    </ItemGroup>

</Project>
